{
  "name": "tux-express",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "endgine":{
    "node":"^18.19.1||^20.11.1||^22.0.0"
  },
  "scripts": {
    "ng":"ng",
    "start-dev": "SET \"NODE_ENV=development\"",
    "start-prod": "SET \"NODE_ENV=production\"",
    "build:local":"ng build --configuration local",
    "build:dev":"ng build --configuration development",
    "build:prod":"ng build --configuration production",
    "watch":"ng build --watch --configuration local",
    
   
    "copy-images": "copyfiles -f \"Client/src/assets/images/**\" \"dist/images\"",
    "copy-views": "copyfiles -f \"Server/Views/**\" \"dist/views\"",
    "build:clean": "del-cli \"Client/src/**/*.js.map\" \"Client/src/**/*.js\" \"Client/src/**/*.ngsummary.json\" \"Client/src/**/*.metadata.json\" \"Client/src/**/**/*.ngfactory.ts\" \"Client/src/**/*.ngstyle.ts\" \"Client/src/**/*.shim.ts\""
  },
  "dependencies": {


    "@angular/animations": "^18.0.0",
    "@angular/cdk": "^18.0.0",
    "@angular/common": "^18.0.0",
    "@angular/compiler": "^18.0.0",
    "@angular/core": "^18.0.0",
    "@angular/forms": "^18.0.0",
    "@angular/material": "^18.0.0",
    "@angular/platform-browser": "^18.0.0",
    "@angular/platform-browser-dynamic": "^18.0.0",
    "@angular/router": "^18.0.0",
    "ag-grid-angular": "^28.1.0",
    "ag-grid-community": "^28.1.0",
    "@ng-bootstrap/ng-bootstrap": "^17.0.0",
    "@fortawesome/angular-fontawesome": "^0.15.0",
    "@fortawesome/fontawesome-svg-core": "1.2.32",
    "@fortawesome/free-regular-svg-icons": "5.15.1",
    "@fortawesome/free-solid-svg-icons": "5.15.1",
    "@tinymce/tinymce-angular": "^8.0.1",
    "@types/jquery": "^3.5.16",
    "@types/node": "^22.14.0",
    "zone.js": "~0.14.10",
    "moment": "^2.30.1",
    "ngx-barcode6": "~1.0.26",
    "ngx-moment": "^6.0.2",
    "bootstrap": "^5.3.2",
    "chart.js": "2.9.3",
    "file-saver": "1.3.8",
    "jquery": "^3.6.4"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.0.1",
    "@angular/cli": "^18.0.1",
    "@angular/compiler-cli": "^18.0.0",

    "sequelize-automate": "1.2.2",
    "typescript": "~5.4.2"
  }
}
