    "version": "0.2.0",
    "configurations": [
        {
            "name": "localdb",
            "type": "node",
            "request": "launch",
            "cwd": "${workspaceRoot}",
            "runtimeExecutable": "npm",
            "env":{"NODE_ENV":"development"},
            "console": "integratedTerminal",
            "runtimeArgs": [
                "start"
            ],
            "port": 9229,
            "skipFiles": [
                "<node_internals>/**"
            ]
        },
        {
            "name": "herokudb",
            "type": "node",
            "request": "launch",
            "cwd": "${workspaceRoot}",
            "runtimeExecutable": "npm",
            "env":{"NODE_ENV":"production"},
            "runtimeArgs": [
                "start"
            ],
            "port": 9229,
            "skipFiles": [
                "<node_internals>/**"
            ]
        }
    ]
}